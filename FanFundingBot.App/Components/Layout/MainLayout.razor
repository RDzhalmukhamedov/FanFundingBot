@inherits LayoutComponentBase

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />

<FluentLayout>
    <FluentHeader>
        FanFundingBot
        <FluentSpacer />
        <AuthorizeView>
            <Authorized>
                <form method="post" action="/api/auth/logout">
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Stealth">Выйти</FluentButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </FluentHeader>

    <FluentStack Orientation="Orientation.Horizontal" Width="100%">
        <FluentNavMenu>
            <FluentNavLink Href="/" Match="NavLinkMatch.All">Главная</FluentNavLink>
            <AuthorizeView>
                <Authorized>
                    <FluentNavLink Href="/projects">Проекты</FluentNavLink>
                    <FluentNavLink Href="/my-orders">Мои заказы</FluentNavLink>
                </Authorized>
            </AuthorizeView>
        </FluentNavMenu>

        <FluentBodyContent>
            <div class="page">
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <p class="error">Что-то пошло не так. <a href="/">На главную</a></p>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </FluentBodyContent>
    </FluentStack>
</FluentLayout>
