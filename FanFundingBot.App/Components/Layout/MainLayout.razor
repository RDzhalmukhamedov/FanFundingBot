@inherits LayoutComponentBase

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />

<FluentLayout>
    <FluentHeader>
        FanFundingBot
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <FluentAnchor Href="/" Appearance="@(IsActive("/") ? Appearance.Accent : Appearance.Hypertext)">Главная</FluentAnchor>
            <AuthorizeView>
                <Authorized>
                    <FluentAnchor Href="/projects" Appearance="@(IsActive("/projects") ? Appearance.Accent : Appearance.Hypertext)">Проекты</FluentAnchor>
                    <FluentAnchor Href="/my-orders" Appearance="@(IsActive("/my-orders") ? Appearance.Accent : Appearance.Hypertext)">Мои заказы</FluentAnchor>
                </Authorized>
            </AuthorizeView>
        </FluentStack>
        <FluentSpacer />
        <AuthorizeView>
            <Authorized>
                <form method="post" action="/api/auth/logout">
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Stealth">Выйти</FluentButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </FluentHeader>

    <FluentBodyContent>
        <div class="page">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <p class="error">Что-то пошло не так. <a href="/">На главную</a></p>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </FluentBodyContent>
</FluentLayout>
