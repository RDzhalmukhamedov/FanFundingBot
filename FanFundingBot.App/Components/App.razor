<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <HeadOutlet />
    <style>
        body { font-family: Segoe UI, Arial, sans-serif; margin: 0; background: #f5f5f5; color: #222; }
        .page { max-width: 960px; margin: 0 auto; padding: 16px; }
        header.nav { background: #1f2937; color: #fff; padding: 12px 16px; }
        header.nav a { color: #fff; margin-right: 16px; text-decoration: none; }
        header.nav a:hover { text-decoration: underline; }
        .card { background: #fff; border-radius: 8px; padding: 16px; margin: 12px 0; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
        table.orders { width: 100%; border-collapse: collapse; }
        table.orders th, table.orders td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        table.orders th { background: #f0f0f0; }
        .btn { padding: 8px 14px; border: none; border-radius: 6px; cursor: pointer; margin-right: 8px; }
        .btn-primary { background: #2563eb; color: #fff; }
        .btn-danger { background: #dc2626; color: #fff; }
        .btn-secondary { background: #e5e7eb; color: #111; }
        .btn:disabled { opacity: .5; cursor: not-allowed; }
        .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; }
        .modal { background: #fff; border-radius: 8px; padding: 20px; min-width: 320px; max-width: 520px; width: 90%; }
        .modal textarea, .modal input, .modal select, .form input, .form textarea, .form select { width: 100%; padding: 8px; margin: 6px 0 12px; box-sizing: border-box; }
        .error { color: #dc2626; }
        .muted { color: #666; }
        .tooltip { position: relative; display: inline-block; }
        .tooltip .tooltiptext { visibility: hidden; background: #111; color: #fff; border-radius: 6px; padding: 6px 10px; position: absolute; z-index: 1; bottom: 125%; left: 0; white-space: nowrap; }
        .tooltip:hover .tooltiptext { visibility: visible; }
        .tabs { display: flex; gap: 8px; margin: 16px 0 12px; border-bottom: 1px solid #e5e7eb; padding-bottom: 12px; }
        .tabs .btn { margin-right: 0; }
        .tabs .active { font-weight: 600; }
        .addon-row { display: flex; align-items: center; gap: 12px; width: 100%; }
        .addon-row .addon-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
        .addon-row .addon-field label { margin: 0; }
        .addon-row .addon-field input, .addon-row .addon-field textarea { width: 100%; min-width: 0; box-sizing: border-box; padding: 8px; margin: 0; }
        .addon-row .addon-name { flex: 0 0 200px; }
        .addon-row .addon-desc { flex: 1; }
        .addon-row .addon-price { flex: 0 0 100px; }
        .addon-row .addon-actions { display: flex; flex-direction: column; gap: 4px; flex-shrink: 0; align-self: stretch; }
        .addon-row .addon-actions .addon-actions-spacer { margin: 0; visibility: hidden; }
        .addon-row .addon-actions .addon-actions-btn { flex: 1; display: flex; align-items: center; }
        .addon-row .addon-actions .btn { margin-right: 0; }
    </style>
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
