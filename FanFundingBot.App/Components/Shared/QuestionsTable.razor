@using FanFundingBot.Application.Questions.DTOs

@if (Questions is not null)
{
    <div class="table-wrap">
    <table class="orders">
        <thead>
            <tr>
                <th>Вопрос</th>
                <th>Пользователь</th>
                <th>Дата</th>
                <th>Ответ</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Questions)
            {
                <tr>
                    <td>@q.Text</td>
                    <td>@(q.Username is not null ? "@" + q.Username : q.FirstName is not null ? q.FirstName : q.UserId.ToString())</td>
                    <td>@q.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@(q.Answer ?? string.Empty)</td>
                    <td>
                        <button type="button" class="btn btn-secondary" @onclick="() => Answer(q)">Ответить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
