@using FanFundingBot.Application.Questions.DTOs

@if (Questions is not null)
{
    <table class="orders">
        <thead>
            <tr>
                <th>Вопрос</th>
                <th>Пользователь</th>
                <th>Дата</th>
                <th>Ответ</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Questions)
            {
                <tr>
                    <td>@q.Text</td>
                    <td>@(q.Username is not null ? "@" + q.Username : q.FirstName is not null ? q.FirstName : q.UserId.ToString())</td>
                    <td>@q.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <textarea rows="3" value="@Answers.GetValueOrDefault(q.Id, string.Empty)" @oninput="(e) => OnInput(q.Id, e.Value?.ToString() ?? string.Empty)" placeholder="Ваш ответ..." style="width:100%;min-width:180px;"></textarea>
                    </td>
                    <td>
                        <button class="btn btn-secondary" @onclick="() => Answer(q)">Ответить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
