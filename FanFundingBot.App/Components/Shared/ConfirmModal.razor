@if (Visible)
{
    <div class="modal-backdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-label="@Title">
            <h3>@Title</h3>
            <p>@Text</p>
            @if (!string.IsNullOrEmpty(Error))
            {
                <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
            }
            <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" OnClick="ConfirmAsync">Подтвердить</FluentButton>
            <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="Cancel">Отмена</FluentButton>
        </div>
    </div>
}
