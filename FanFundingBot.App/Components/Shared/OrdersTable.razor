@if (Orders is not null)
{
    <div class="table-wrap">
    <table class="orders">
        <thead>
            <tr>
                <th>Пользователь</th>
                <th>Телефон</th>
                <th>Доставка</th>
                <th>Позиции</th>
                <th>Сумма</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Orders)
            {
                <tr>
                    <td>@(order.Username is not null ? "@" + order.Username : order.FirstName is not null ? order.FirstName : order.UserId.ToString())</td>
                    <td>@order.Phone</td>
                    <td>@order.DeliveryMethod@(order.Address is not null ? $" ({order.Address})" : "")</td>
                    <td>
                        @foreach (var p in order.Positions)
                        {
                            <div>@p.AddonName × @p.Quantity</div>
                        }
                    </td>
                    <td>@order.Total.ToString("F2")</td>
                    <td><StatusBadge Status="order.Status" /></td>
                    <td>
                        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="() => ChangeStatus(order)">Статус</FluentButton>
                        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="() => WriteMessage(order)">Написать</FluentButton>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
