@if (Orders is not null)
{
    <table class="orders">
        <thead>
            <tr>
                <th>Пользователь</th>
                <th>Телефон</th>
                <th>Доставка</th>
                <th>Позиции</th>
                <th>Сумма</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Orders)
            {
                <tr>
                    <td>@order.UserId</td>
                    <td>@order.Phone</td>
                    <td>@order.DeliveryMethod@(order.Address is not null ? $" ({order.Address})" : "")</td>
                    <td>
                        @foreach (var p in order.Positions)
                        {
                            <div>@p.AddonName × @p.Quantity</div>
                        }
                    </td>
                    <td>@order.Total</td>
                    <td><StatusBadge Status="order.Status" /></td>
                    <td>
                        <button class="btn btn-secondary" @onclick="() => ChangeStatus(order)">Статус</button>
                        <button class="btn btn-secondary" @onclick="() => WriteMessage(order)">Написать</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
