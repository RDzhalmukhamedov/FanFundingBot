@page "/projects/new"
@attribute [Authorize]
@inherits AuthComponentBase
@rendermode InteractiveServer

<PageTitle>Новый проект</PageTitle>

<h1>Новый проект</h1>

<div class="form card">
    <label>Название</label>
    <input @bind="Name" maxlength="256" />

    <label>Описание</label>
    <textarea rows="4" @bind="Description" maxlength="2048" />

    <h3>Дополнения</h3>
    @for (var i = 0; i < Addons.Count; i++)
    {
        var index = i;
        <div class="card">
            <div class="addon-row">
                <div class="addon-field addon-name">
                    <label>Название</label>
                    <input @bind="Addons[index].Name" maxlength="256" />
                </div>
                <div class="addon-field addon-desc">
                    <label>Описание</label>
                    <textarea rows="2" @bind="Addons[index].Description" maxlength="2048" />
                </div>
                <div class="addon-field addon-price">
                    <label>Цена</label>
                    <input type="number" min="0" step="0.01" @bind="Addons[index].Price" />
                </div>
                <div class="addon-actions">
                    <label class="addon-actions-spacer" aria-hidden="true">&nbsp;</label>
                    <div class="addon-actions-btn">
                        <button class="btn btn-secondary" @onclick="() => RemoveAddon(index)">Убрать</button>
                    </div>
                </div>
            </div>
        </div>
    }
    <button class="btn btn-secondary" @onclick="AddAddon">Добавить дополнение</button>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="error">@Error</p>
    }
    <button class="btn btn-primary" @onclick="SaveAsync">Создать</button>
</div>
