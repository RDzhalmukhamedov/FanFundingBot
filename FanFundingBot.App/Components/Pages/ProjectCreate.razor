@page "/projects/new"
@attribute [Authorize]
@inherits AuthComponentBase
@rendermode InteractiveServer

<PageTitle>Новый проект</PageTitle>

<h1>Новый проект</h1>

<EditForm Model="Form" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <div class="form card">
        <label>Название</label>
        <FluentTextField @bind-Value="Form.Name" Maxlength="256" aria-label="Название" />
        <FluentValidationMessage For="@(() => Form.Name)" />

        <label>Описание</label>
        <FluentTextArea @bind-Value="Form.Description" Rows="4" Maxlength="2048" aria-label="Описание" />
        <FluentValidationMessage For="@(() => Form.Description)" />

        <h3>Дополнения</h3>
        @for (var i = 0; i < Addons.Count; i++)
        {
            var index = i;
            <div class="card">
                <div class="addon-row">
                    <div class="addon-field addon-name">
                        <label>Название</label>
                        <FluentTextField @bind-Value="Addons[index].Name" Maxlength="256" aria-label="Название дополнения" />
                    </div>
                    <div class="addon-field addon-desc">
                        <label>Описание</label>
                        <FluentTextArea @bind-Value="Addons[index].Description" Rows="2" Maxlength="2048" aria-label="Описание дополнения" />
                    </div>
                    <div class="addon-field addon-price">
                        <label>Цена</label>
                        <FluentNumberField TValue="decimal" @bind-Value="Addons[index].Price" Min="0" Step="0.01" HideStep="true" aria-label="Цена дополнения" />
                    </div>
                    <div class="addon-actions">
                        <label class="addon-actions-spacer" aria-hidden="true">&nbsp;</label>
                        <div class="addon-actions-btn">
                            <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="() => RemoveAddon(index)">Убрать</FluentButton>
                        </div>
                    </div>
                </div>
            </div>
        }
        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="AddAddon">Добавить дополнение</FluentButton>

        @if (!string.IsNullOrEmpty(Error))
        {
            <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
        }
        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Loading="@IsSaving">Создать</FluentButton>
    </div>
</EditForm>
