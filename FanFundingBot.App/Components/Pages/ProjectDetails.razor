@page "/projects/{id:guid}"
@attribute [Authorize]
@inherits AuthComponentBase
@rendermode InteractiveServer

<PageTitle>Проект</PageTitle>

@if (Project is null)
{
    <FluentProgressRing />
}
else
{
    <h1>@Project.Name</h1>

    @if (!string.IsNullOrEmpty(Error))
    {
        <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
    }

    <div class="card">
        <p>@Project.Description</p>
        <p class="muted">Статус: @Project.StatusName @(Project.CanEditOrders ? "(✅ можно ред.)" : "(❌ нельзя ред.)")</p>
        <FluentSelect TOption="ProjectStatusDto"
                      Items="Statuses"
                      OptionText="@(s => s.DisplayName + (s.CanEditOrders ? " (✅ можно ред.)" : " (❌ нельзя ред.)"))"
                      @bind-SelectedOption="SelectedProjectStatus" />
        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="AskProjectStatusAsync">Сменить статус</FluentButton>
        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="EditProject">Редактировать</FluentButton>
        <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="AskBroadcastAsync">Сделать рассылку</FluentButton>
    </div>

    <div class="tabs">
        <FluentButton Type="ButtonType.Button" Appearance='@(ActiveTab == "overview" ? Appearance.Accent : Appearance.Neutral)' OnClick='() => ActiveTab = "overview"'>Обзор</FluentButton>
        <FluentButton Type="ButtonType.Button" Appearance='@(ActiveTab == "orders" ? Appearance.Accent : Appearance.Neutral)' OnClick='() => ActiveTab = "orders"'>Заказы (@OrdersTotalCount)</FluentButton>
        <FluentButton Type="ButtonType.Button" Appearance='@(ActiveTab == "questions" ? Appearance.Accent : Appearance.Neutral)' OnClick='() => ActiveTab = "questions"'>Вопросы (@QuestionsTotalCount)</FluentButton>
    </div>

    @if (ActiveTab == "overview")
    {
        <div class="card">
            <h3>Дополнения</h3>
            @if (Project.Addons.Count == 0)
            {
                <p class="muted">Дополнений пока нет.</p>
            }
            else
            {
                <div class="table-wrap">
                <FluentDataGrid Items="@(Project.Addons.AsQueryable())" TGridItem="AddonDto" Style="width: 100%;">
                    <ChildContent>
                    <TemplateColumn Title="Название">
                        @context.Name
                        @if (context.HasOrders)
                        {
                            <span title="Это дополнение есть в одном или нескольких заказах.">🔒</span>
                        }
                    </TemplateColumn>
                    <PropertyColumn Property="@(a => a.Description)" Title="Описание" />
                    <TemplateColumn Title="Цена">
                        @context.Price.ToString("F2")
                    </TemplateColumn>
                    </ChildContent>
                </FluentDataGrid>
                </div>
            }
        </div>

        <div class="card">
            <h3>Таблица заказов</h3>
            @if (SheetUrl is null)
            {
                <p class="muted">Загрузка ссылки...</p>
            }
            else
            {
                <a href="@SheetUrl" target="_blank" rel="noopener">Открыть Google-таблицу</a>
            }
        </div>
    }
    else if (ActiveTab == "orders")
    {
        <div class="card">
            <h3>Заказы</h3>
            <OrdersTable @ref="_ordersTable" ItemsProvider="OrdersProvider" Pagination="_ordersPagination" OnStatusChange="AskOrderStatus" OnMessage="AskMessageAsync" />
        </div>
    }
    else if (ActiveTab == "questions")
    {
        <div class="card">
            <h3>Вопросы пользователей</h3>
            <QuestionsTable @ref="_questionsTable" ItemsProvider="QuestionsProvider" Pagination="_questionsPagination" OnAnswer="AskAnswerAsync" />
        </div>
    }
}

@if (OrderStatusTarget is not null)
{
    <div class="modal-backdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-label="Смена статуса заказа">
            <h3>Смена статуса заказа</h3>
            <FluentSelect TOption="OrderStatus"
                          Items="OrderStatuses"
                          OptionText="@(OrderStatusTexts.Text)"
                          @bind-SelectedOption="OrderStatusValue" />
            @if (!string.IsNullOrEmpty(ModalError))
            {
                <FluentMessageBar Intent="MessageIntent.Error">@ModalError</FluentMessageBar>
            }
            <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" OnClick="ChangeOrderStatusAsync">Подтвердить</FluentButton>
            <FluentButton Type="ButtonType.Button" Appearance="Appearance.Neutral" OnClick="() => OrderStatusTarget = null">Отмена</FluentButton>
        </div>
    </div>
}

