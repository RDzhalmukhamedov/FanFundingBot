@page "/projects/{id:guid}"
@attribute [Authorize]
@inherits AuthComponentBase
@rendermode InteractiveServer

<PageTitle>Проект</PageTitle>

@if (Project is null)
{
    <p class="muted">Загрузка...</p>
}
else
{
    <h1>@Project.Name</h1>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="error">@Error</p>
    }

    <div class="card">
        <p>@Project.Description</p>
        <p class="muted">Статус: @Project.StatusName @(Project.CanEditOrders ? "(✅ можно ред.)" : "(❌ нельзя ред.)")</p>
        <select @bind="NewStatusId">
            @foreach (var s in Statuses)
            {
                <option value="@s.Id">@s.DisplayName @(s.CanEditOrders ? "(✅ можно ред.)" : "(❌ нельзя ред.)")</option>
            }
        </select>
        <button type="button" class="btn btn-secondary" @onclick="AskProjectStatus">Сменить статус</button>
        <button type="button" class="btn btn-secondary" @onclick="EditProject">Редактировать</button>
        <button type="button" class="btn btn-secondary" @onclick="AskBroadcast">Сделать рассылку</button>
    </div>

    <div class="tabs">
        <button type="button" class="btn @(ActiveTab == "overview" ? "btn-primary active" : "btn-secondary")" @onclick='() => ActiveTab = "overview"'>Обзор</button>
        <button type="button" class="btn @(ActiveTab == "orders" ? "btn-primary active" : "btn-secondary")" @onclick='() => ActiveTab = "orders"'>Заказы (@OrdersTotalCount)</button>
        <button type="button" class="btn @(ActiveTab == "questions" ? "btn-primary active" : "btn-secondary")" @onclick='() => ActiveTab = "questions"'>Вопросы (@QuestionsTotalCount)</button>
    </div>

    @if (ActiveTab == "overview")
    {
        <div class="card">
            <h3>Дополнения</h3>
            @if (Project.Addons.Count == 0)
            {
                <p class="muted">Дополнений пока нет.</p>
            }
            else
            {
                <div class="table-wrap">
                <table class="orders">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Описание</th>
                            <th>Цена</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var addon in Project.Addons)
                        {
                            <tr>
                                <td>
                                    @addon.Name
                                    @if (addon.HasOrders)
                                    {
                                        <span title="Это дополнение есть в одном или нескольких заказах.">🔒</span>
                                    }
                                </td>
                                <td>@addon.Description</td>
                                <td>@addon.Price.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>

        <div class="card">
            <h3>Таблица заказов</h3>
            @if (SheetUrl is null)
            {
                <p class="muted">Загрузка ссылки...</p>
            }
            else
            {
                <a href="@SheetUrl" target="_blank" rel="noopener">Открыть Google-таблицу</a>
            }
        </div>
    }
    else if (ActiveTab == "orders")
    {
        <div class="card">
            <h3>Заказы</h3>
            @if (Orders.Count == 0)
            {
                <p class="muted">Заказов пока нет.</p>
            }
            else
            {
                <OrdersTable Orders="Orders" OnStatusChange="AskOrderStatus" OnMessage="AskMessage" />
                <div class="pagination">
                    <button type="button" class="btn btn-secondary" @onclick="OrdersPrevAsync" disabled="@(OrdersPage <= 1)">◀ Назад</button>
                    <span class="muted">Страница @OrdersPage из @OrdersTotalPages</span>
                    <button type="button" class="btn btn-secondary" @onclick="OrdersNextAsync" disabled="@(OrdersPage >= OrdersTotalPages)">Вперёд ▶</button>
                </div>
            }
        </div>
    }
    else if (ActiveTab == "questions")
    {
        <div class="card">
            <h3>Вопросы пользователей</h3>
            @if (Questions.Count == 0)
            {
                <p class="muted">Вопросов пока нет.</p>
            }
            else
            {
                <QuestionsTable Questions="Questions" OnAnswer="AskAnswer" />
                <div class="pagination">
                    <button type="button" class="btn btn-secondary" @onclick="QuestionsPrevAsync" disabled="@(QuestionsPage <= 1)">◀ Назад</button>
                    <span class="muted">Страница @QuestionsPage из @QuestionsTotalPages</span>
                    <button type="button" class="btn btn-secondary" @onclick="QuestionsNextAsync" disabled="@(QuestionsPage >= QuestionsTotalPages)">Вперёд ▶</button>
                </div>
            }
        </div>
    }
}

<ConfirmModal Visible="ProjectStatusConfirm"
              Title="Смена статуса проекта"
              Text="@($"Установить статус «{NewStatusName}»? Подписанным пользователям придёт оповещение.")"
              Error="@ModalError"
              OnConfirm="ChangeProjectStatusAsync"
              OnCancel="() => ProjectStatusConfirm = false" />

@if (OrderStatusTarget is not null)
{
    <div class="modal-backdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-label="Смена статуса заказа">
            <h3>Смена статуса заказа</h3>
            <select @bind="OrderStatusValue">
                @foreach (var s in Enum.GetValues<OrderStatus>())
                {
                    <option value="@s">@OrderStatusText(s)</option>
                }
            </select>
            @if (!string.IsNullOrEmpty(ModalError))
            {
                <p class="error">@ModalError</p>
            }
            <button type="button" class="btn btn-primary" @onclick="ChangeOrderStatusAsync">Подтвердить</button>
            <button type="button" class="btn btn-secondary" @onclick="() => OrderStatusTarget = null">Отмена</button>
        </div>
    </div>
}

<MessageModal Visible="MessageTarget is not null"
              Title="Сообщение пользователю"
              Error="@ModalError"
              OnConfirm="SendMessageAsync"
              OnCancel="() => MessageTarget = null" />

<MessageModal Visible="AnswerTarget is not null"
              Title="Ответ на вопрос"
              Error="@ModalError"
              OnConfirm="SendAnswerAsync"
              OnCancel="() => AnswerTarget = null" />

<MessageModal Visible="BroadcastOpen"
              Title="Рассылка подписанным пользователям"
              Error="@ModalError"
              OnConfirm="BroadcastAsync"
              OnCancel="() => BroadcastOpen = false" />
