@page "/projects/{id:guid}/edit"

<PageTitle>Редактирование проекта</PageTitle>

<h1>Редактирование проекта</h1>

@if (Project is null)
{
    <p class="muted">Загрузка...</p>
}
else
{
    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="error">@Error</p>
    }
    <div class="form card">
        <label>Название</label>
        <input @bind="Name" maxlength="256" />
        <label>Описание</label>
        <textarea rows="4" @bind="Description" maxlength="2048" />
        <button class="btn btn-primary" @onclick="SaveAsync">Сохранить</button>
    </div>

    <div class="card">
        <h3>Дополнения</h3>
        @for (var i = 0; i < Addons.Count; i++)
        {
            var index = i;
            <div class="card">
                <label>Название</label>
                <input @bind="Addons[index].Name" maxlength="256" />
                <label>Описание</label>
                <textarea rows="2" @bind="Addons[index].Description" maxlength="2048" />
                <label>Цена</label>
                <input type="number" min="0" step="0.01" @bind="Addons[index].Price" />
                <button class="btn btn-secondary" @onclick="() => SaveAddonAsync(Addons[index])">Сохранить</button>
                <button class="btn btn-danger" @onclick="() => AskDeleteAddon(Addons[index].Id)">Удалить</button>
            </div>
        }
        <h4>Новое дополнение</h4>
        <label>Название</label>
        <input @bind="NewName" maxlength="256" />
        <label>Описание</label>
        <textarea rows="2" @bind="NewDescription" maxlength="2048" />
        <label>Цена</label>
        <input type="number" min="0" step="0.01" @bind="NewPrice" />
        <button class="btn btn-secondary" @onclick="AddAddonAsync">Добавить</button>
    </div>
}

<ConfirmModal Visible="DeleteAddonTarget.HasValue"
              Title="Удаление дополнения"
              Text="Удалить дополнение? Действие необратимо."
              Error="@DeleteError"
              OnConfirm="DeleteAddonAsync"
              OnCancel="CancelDeleteAddon" />
