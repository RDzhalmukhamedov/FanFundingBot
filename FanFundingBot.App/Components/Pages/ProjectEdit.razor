@page "/projects/{id:guid}/edit"
@attribute [Authorize]
@inherits AuthComponentBase
@rendermode InteractiveServer

<PageTitle>Редактирование проекта</PageTitle>

<h1>Редактирование проекта</h1>

@if (Project is null)
{
    <p class="muted">Загрузка...</p>
}
else
{
    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="error">@Error</p>
    }
    <div class="form card">
        <label>Название</label>
        <input @bind="Name" @bind:after="OnFieldChanged" maxlength="256" />
        <label>Описание</label>
        <textarea rows="4" @bind="Description" @bind:after="OnFieldChanged" maxlength="2048" />
    </div>

    <div class="card">
        <h3>Дополнения</h3>
        @for (var i = 0; i < Addons.Count; i++)
        {
            var index = i;
            <div class="card">
                <div class="addon-row">
                    <div class="addon-field addon-name">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <label style="margin:0;">Название</label>
                            @if (Addons[index].HasOrders)
                            {
                                <span title="Это дополнение есть в одном или нескольких заказах.">🔒</span>
                            }
                        </div>
                        <input @bind="Addons[index].Name" @bind:after="OnFieldChanged" maxlength="256" />
                    </div>
                    <div class="addon-field addon-desc">
                        <label>Описание</label>
                        <textarea rows="2" @bind="Addons[index].Description" @bind:after="OnFieldChanged" maxlength="2048" />
                    </div>
                    <div class="addon-field addon-price">
                        <label>Цена</label>
                        <input type="number" min="0" step="0.01" @bind="Addons[index].Price" @bind:after="OnFieldChanged" />
                    </div>
                    <div class="addon-actions">
                        <label class="addon-actions-spacer" aria-hidden="true">&nbsp;</label>
                        <div class="addon-actions-btn">
                            @if (Addons[index].HasOrders)
                            {
                                <button type="button" class="btn btn-danger" disabled title="Это дополнение есть в одном или нескольких заказах.">Удалить</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-danger" @onclick="() => AskDeleteAddon(Addons[index].Id)">Удалить</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (NewAddons.Count > 0)
        {
            <h4>Новые дополнения (не сохранены)</h4>
            @for (var i = 0; i < NewAddons.Count; i++)
            {
                var index = i;
                <div class="card">
                    <div class="addon-row">
                        <div class="addon-field addon-name">
                            <label>Название</label>
                            <input @bind="NewAddons[index].Name" @bind:after="OnFieldChanged" maxlength="256" />
                        </div>
                        <div class="addon-field addon-desc">
                            <label>Описание</label>
                            <textarea rows="2" @bind="NewAddons[index].Description" @bind:after="OnFieldChanged" maxlength="2048" />
                        </div>
                        <div class="addon-field addon-price">
                            <label>Цена</label>
                            <input type="number" min="0" step="0.01" @bind="NewAddons[index].Price" @bind:after="OnFieldChanged" />
                        </div>
                        <div class="addon-actions">
                            <label class="addon-actions-spacer" aria-hidden="true">&nbsp;</label>
                            <div class="addon-actions-btn">
                                <button type="button" class="btn btn-secondary" @onclick="() => RemoveNewAddon(index)">Убрать</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <button type="button" class="btn btn-secondary" @onclick="AddNewAddon">Добавить дополнение</button>
    </div>

    <div class="card">
        <button type="button" class="btn btn-primary" disabled="@(!IsDirty || IsSaving)" @onclick="SaveAllAsync">Сохранить</button>
        @if (!IsDirty)
        {
            <span class="muted" style="margin-left:8px;">Нет изменений для сохранения</span>
        }
    </div>
}

<ConfirmModal Visible="DeleteAddonTarget.HasValue"
              Title="Удаление дополнения"
              Text="Удалить дополнение? Действие будет применено при сохранении."
              Error="@DeleteError"
              OnConfirm="ConfirmDeleteAddon"
              OnCancel="CancelDeleteAddon" />
