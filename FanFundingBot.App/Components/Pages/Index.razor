@page "/"
@inherits AuthComponentBase
@rendermode InteractiveServer

<PageTitle>FanFundingBot</PageTitle>

<h1>FanFundingBot — совместные закупки</h1>

<AuthorizeView>
    <Authorized>
        <p>Вы вошли. <a href="/projects">Перейти к проектам</a></p>
        <div class="card">
            <h2>Проекты</h2>
            @if (Catalog is null)
            {
                <FluentProgressRing aria-label="Загрузка" />
            }
            else
            {
                @if (!string.IsNullOrEmpty(Error))
                {
                    <FluentMessageBar Intent="MessageIntent.Error">@Error</FluentMessageBar>
                }
                @if (Catalog.Count == 0 && string.IsNullOrEmpty(Error))
                {
                    <p class="muted">Пока нет доступных проектов.</p>
                }
                else
                {
                    @foreach (var project in Catalog)
                    {
                        <div class="card">
                            <h3>@project.Name</h3>
                            <p>@project.Description</p>
                            <p class="muted">Статус: @project.StatusName</p>
                        </div>
                    }
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="card">
            <p>Войдите через Telegram, чтобы просматривать проекты и заказы.</p>
            @if (!string.IsNullOrEmpty(ClientId))
            {
                <script src="https://telegram.org/js/telegram-login.js"></script>
                <script src="js/auth.js"></script>
                <button class="tg-login-btn" data-client-id="@ClientId" onclick="telegramLoginFromButton(this)">
                    <span class="tg-login-icon" aria-hidden="true">
                        <svg viewBox="0 0 448 512" width="16" height="16"><path fill="#fff" d="M446.7 98.6l-67.6 318.8c-5.1 22.5-18.4 28.1-37.3 17.5l-103-75.9-49.7 47.8c-5.5 5.5-10.1 10.1-20.7 10.1l7.4-104.9 190.9-172.5c8.3-7.4-1.8-11.5-12.9-4.1L117.8 284 16.2 252.2c-22.1-6.9-22.5-22.1 4.6-32.7L418.9 6.1c18.4-6.9 34.5 4.1 27.8 92.5z" /></svg>
                    </span>
                    <span>Войти через Telegram</span>
                </button>
                <p id="login-error" class="error" role="alert" hidden>Не удалось войти. Попробуйте позже.</p>
            }
            else
            {
                <p class="muted">Вход временно недоступен (не настроен BotConfiguration:ClientId).</p>
            }
        </div>
    </NotAuthorized>
</AuthorizeView>
